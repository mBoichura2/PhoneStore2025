@using static PhoneStore2025.Controllers.GalleryController
@model List<Phone>

@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<p>Я люблю </p>

<button type="button" class="btn btn-outline-success">Success</button>

<p class="fst-italic">Italic text.</p>


<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var phone in Model)
    {
        <div class="col">
            <div class="card h-100">
                <img src="https://applehome.te.ua/wp-content/uploads/2021/09/iphone-13-pink-select-2021.png" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@phone.Manufacturer @phone.PhoneModel </h5>
                    <p class="card-text">price $@phone.Price</p>
                </div>
                <a class="btn btn-primary" asp-action="Delete" asp-route-id="@phone.Id" role="button">Delete</a>
                <a class="btn btn-primary" asp-action="Update" asp-route-id="@phone.Id" role="button">Update</a>
            </div>
        </div>
    }
</div>

<a class="btn btn-primary" asp-action="Create" role="button">Add phone</a>
